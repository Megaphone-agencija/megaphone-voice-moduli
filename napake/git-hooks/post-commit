#!/usr/bin/env python3
"""post-commit: zažene stej.py v ozadju. Nikoli ne upočasni ali zruši commita."""
import subprocess
import sys
from pathlib import Path

try:
    stej = Path(__file__).resolve().parent.parent / "stej.py"
    subprocess.Popen(
        [sys.executable, str(stej)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True, close_fds=True,
    )
except Exception:
    pass
sys.exit(0)
